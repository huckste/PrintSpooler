@baseUrl = http://localhost:5164
# Fill these from your own DB — IDs are per-database
@printerId = 00000000-0000-0000-0000-000000000000
@jobId = 00000000-0000-0000-0000-000000000000

### Create a job (unknown printer - should 404)
POST {{baseUrl}}/PrintJob
Content-Type: application/json

{
  "submittedBy": "test",
  "fileName": "test.pdf",
  "rawData": "aGVsbG8=",
  "contentType": "application/pdf",
  "printerId": "00000000-0000-0000-0000-000000000000"
}

### Create a job (valid printer)
POST {{baseUrl}}/PrintJob
Content-Type: application/json

{
  "submittedBy": "test-retry",
  "fileName": "test.pdf",
  "rawData": "aGVsbG8=",
  "contentType": "application/pdf",
  "printerId": "{{printerId}}"
}

### Get a job (unknown job - should 404)
GET {{baseUrl}}/PrintJob/00000000-0000-0000-0000-000000000000

### Get a job (valid job)
GET {{baseUrl}}/PrintJob/{{jobId}}

### Get all active jobs
GET {{baseUrl}}/PrintJob/

### HealthChecks
GET {{baseUrl}}/health

### logs
GET {{baseUrl}}/Logs?actionFilter=Created&performedBy=User&page=2&pageSize=5

### Cancel a job (valid job)
POST {{baseUrl}}/PrintJob/{{jobId}}/cancel

### Create a printer (no host - should 400)
POST {{baseUrl}}/Printer
Content-Type: application/json

{
  "ipAddress": "192.168.0.10",
  "name": "TEST NO HOST"
}

### Get a printer (valid)
GET {{baseUrl}}/Printer/{{printerId}}

### Get a printer (unknown - should 404)
GET {{baseUrl}}/Printer/00000000-0000-0000-0000-000000000000
