@using PrintSpooler.Core.Models
@using PrintSpooler.Web.Models
@using PrintSpooler.Web.Services

<div @key="Key" class="sp-panel sp-printer-card @(cardExpanded ? "sp-printer-card-expanded" : "")">
  <div class="sp-printer-row" @onclick="ToggleCard" @onmouseleave="HandleRowMouseLeave">
    <span
    class="sp-printer-status-dot sp-printer-status-dot-@(PrinterWebService.IsOnline(Printer.Status) ? "online" : "offline")"></span>
    <span class="sp-printer-name">@(Printer.Name)
      <span class="sp-printer-model">[ @(Printer.Status) ]</span>
    </span>
    <div class="sp-printer-stats">
      @if (selectedRows.Count > 0)
      {
        <span class="sp-printer-stat">
          <span class="sp-printer-stat-value">@(selectedRows.Count) selected</span>
        </span>
      }
      else
      {
        @foreach (var status in printerStats)
        {
          <span class="sp-printer-stat">
            <span class="sp-printer-stat-label">@(status)</span>
            <span class="sp-printer-stat-value">@(JobWebService.CountByStatus(status, Rows))</span>
          </span>
        }
      }
    </div>
    <div class="sp-printer-row-actions" @onclick:stopPropagation>
      <div class="sp-printer-actions-tray @(ShowActions ? "sp-printer-actions-tray-open" : "")">

        @{
          var states = GetRowStates();

          if (selectedRows.Count == 0)
          {
            <label class="sp-btn">Add
              <InputFile multiple OnChange="(e) => HandleFileSelected(e, Printer.Id)" style="display:none;" />
            </label>
          }
          else
          {
            <button class="sp-btn" @onclick="() => { selectedRows.Clear(); actionsOpen = false; }">Cancel</button>
          }

          foreach (var action in actions)
          {
            if (ShowActionButton(action, states))
            {
              <button class="sp-btn" @onclick="() => HandleActions(action)" @onmouseenter="() => SetHoveredAction(action)"
                      @onmouseleave="ClearHoveredAction">@(action)</button>
            }
          }
        }

      </div>
      <button class="sp-printer-actions-hint @(ShowActions ? "sp-printer-actions-hint-open" : "")"
              @onclick="ToggleActionsHint">⋮</button>
      <button class="sp-printer-chevron" @onclick="ToggleCard">▾</button>
    </div>
  </div>

  @if (cardExpanded)
  {
    <div class="sp-printer-detail">
      <div class="sp-printer-detail-pad">
        <div class="sp-panel sp-table-wrapper sp-printer-table-wrapper">
          <table class="sp-table">
            <colgroup>
              <col />
              <col style="width: 100px" />
              <col style="width: 100px" />
              <col style="width: 100px" />
              <col style="width: 120px" />
              <col style="width: 40px" />
            </colgroup>
            <thead>
              <tr>
                <th>Document</th>
                <th class="sp-table-num">Size</th>
                <th class="sp-table-num">Retries</th>
                <th>Submitted</th>
                <th class="sp-table-status">Status</th>
                <th class="sp-table-action"></th>
              </tr>
            </thead>
            <tbody>

              @foreach (var row in Rows)
              {
                <tr @key="row.Id" class="@(selectedRows.Contains(row.Id) ? "sp-row-active" : "") 
                  @(FadingRowIds.Contains(row.Id) ? "sp-row-fading" : "") 
                  @(CompletedRowIds.Contains(row.Id) ? "sp-row-completed" : "") 
                  @(IsPreviewTarget(row) ? "sp-row-preview" : "")" @onclick="() => HandleRowClicked(row.Id)">

                  <td class="sp-table-primary">@(row.FileName)</td>
                  <td class="sp-table-num sp-table-muted">@(FormatBytes.Short(row.SizeBytes))</td>
                  <td class="sp-table-num sp-table-muted">@(row.RetryCount)</td>
                  <td class="sp-table-muted">
                    @(row.SubmittedAt is DateTime submittedAt ? FormatTime.Short(submittedAt) : "—")
                  </td>
                  <td class="sp-table-status">
                    <span class="sp-tag sp-tag-@(row.Status.ToString().ToLower())"
                          title="@(ShowRowError(row))">@(row.Status)</span>
                  </td>
                  <td class="sp-table-action">

                    @if (ShowSpinner(row.Status))
                    {
                      <div class="sp-spinner"></div>
                    }
                  </td>

                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  }
</div>
@code
{
  [Parameter] public List<QueueRow> Rows { get; set; } = [];
  [Parameter] public required Printer Printer { get; set; }
  [Parameter] public object? Key { get; set; }
  [Parameter] public EventCallback<List<QueueRow>> OnFilesAdded { get; set; }
  [Parameter] public EventCallback<ActionArgs> OnRowAction { get; set; }
  [Parameter] public HashSet<Guid> FadingRowIds { get; set; } = [];
  [Parameter] public HashSet<Guid> CompletedRowIds { get; set; } = [];

  private HashSet<RowActions> actions = Enum.GetValues<RowActions>().ToHashSet();
  private HashSet<Guid> selectedRows = [];
  private bool actionsOpen;
  private bool cardExpanded;
  private HashSet<JobStatus> printerStats = [JobStatus.Failed, JobStatus.Processing, JobStatus.Staged];
  private RowActions? hoveredAction;

  private bool ShowSpinner(JobStatus status) => status is JobStatus.Processing or JobStatus.Submitting;
  private string? ShowRowError(QueueRow row) => row.Status == JobStatus.Failed ? row.ErrorText : null;

  private void SetHoveredAction(RowActions action)
  {
    if (selectedRows.Count == 0)
      hoveredAction = action;
  }

  private HashSet<JobStatus> GetRowStates()
  {
    var rows = selectedRows.Count > 0 ? Rows.Where(r => selectedRows.Contains(r.Id)) : Rows;
    return rows.Select(r => r.Status).ToHashSet();
  }

  private bool ShowActionButton(RowActions action, HashSet<JobStatus> states)
  {
    foreach (var state in states)
    {
      if (JobWebService.CanDoAction(action, state))
        return true;
    }

    return false;
  }

  private void ClearHoveredAction() => hoveredAction = null;

  private bool IsPreviewTarget(QueueRow row)
  {
    if (hoveredAction is not { } action)
      return false;

    return JobWebService.CanDoAction(action, row.Status);
  }

  private bool ShowActions => actionsOpen || selectedRows.Count > 0;

  private void ToggleCard() => cardExpanded = !cardExpanded;

  private void ToggleActionsHint() => actionsOpen = !actionsOpen;

  private void HandleRowMouseLeave()
  {
    if (selectedRows.Count == 0)
      actionsOpen = false;
  }

  private async Task HandleFileSelected(InputFileChangeEventArgs e, Guid printerId)
  {
    List<QueueRow> stagedRows = [];

    foreach (var file in e.GetMultipleFiles(20))
    {
      using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
      using var ms = new MemoryStream();
      await stream.CopyToAsync(ms);

      stagedRows.Add(new QueueRow
      {
        PrinterId = printerId,
        FileName = file.Name,
        ContentType = file.ContentType,
        SizeBytes = ms.Length,
        Status = JobStatus.Staged,
        PendingData = ms.ToArray()
      });
    }

    await OnFilesAdded.InvokeAsync(stagedRows);
  }

  private async Task HandleRowClicked(Guid id)
  {
    if (selectedRows.Contains(id))
      selectedRows.Remove(id);
    else
      selectedRows.Add(id);

  }

  private async Task HandleActions(RowActions action)
  {
    await OnRowAction.InvokeAsync(new ActionArgs
    {
      Ids = selectedRows.Count > 0 ? selectedRows : null,
      Action = action,
      PrinterId = Printer.Id
    });

    selectedRows.Clear();
    actionsOpen = false;
  }
}
