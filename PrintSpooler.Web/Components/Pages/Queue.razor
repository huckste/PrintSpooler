@page "/queue"
@using Microsoft.AspNetCore.SignalR.Client
@using PrintSpooler.Core.Models;
@using PrintSpooler.Core.Services;
@using PrintSpooler.Web.Services;
@inject ApiClient api
@inject IConfiguration config
@implements IAsyncDisposable

<PageTitle>Job Queue</PageTitle>

<div class="sp-table-detail-layout">
  <div class="sp-panel sp-table-wrapper">
    <table class="sp-table">
      <colgroup>
        <col />
        <col />
        <col />
        <col />
        <col style="width: 70px" />
        <col style="width: 110px" />
        <col style="width: 40px" />
      </colgroup>
      <thead>
        <tr>
          <th>Document</th>
          <th>Owner</th>
          <th>Printer</th>
          <th class="sp-table-status">Status</th>
          <th class="sp-table-num">Retries</th>
          <th>Submitted</th>
          <th class="sp-table-action"></th>
        </tr>
      </thead>
      @if (jobs.Count < 1)
      {
        <tbody>
          <tr class="sp-empty-row">
            <td colspan="7">Queue is empty</td>
          </tr>
        </tbody>
      }
      else
      {
        <tbody>
          @{
            var i = 0;
          }
          @foreach (var job in jobs)
          {
            <tr @key="job.Id" style="--i: @(i++)"
                class="@(recentlyUpdated.Contains(job.Id) ? "sp-row-updated" : "") @(fadingJobIds.Contains(job.Id) ? "sp-row-fading" : "") @(shownJobId == job.Id ? "sp-row-active" : "")"
                @onmouseenter="() => OnRowHoverStart(job.Id)" @onmouseleave="OnRowHoverEnd">
              <td class="sp-table-primary">@(job.FileName)</td>
              <td class="sp-table-muted">@(job.SubmittedBy)</td>
              <td class="sp-table-muted-sm">@(job.Printer?.Name ?? "Unknown")</td>
              <td class="sp-table-status">
                <span class="sp-tag @(GetStatusClass(job))">@(job.Status)</span>
              </td>
              <td class="sp-table-num">@(job.RetryCount)</td>
              <td class="sp-table-muted">@(FormatTime.Short(job.SubmittedAt))</td>
              <td class="sp-table-action">
                @if (job.Status == JobStatus.Processing)
                {
                  <div class="sp-spinner"></div>
                }
                else if (JobCancellationPolicy.CanCancel(job.Status))
                {
                  <button class="sp-file-entry-remove" @onclick="() => CancelJob(job.Id)">x</button>
                }
              </td>
            </tr>
          }
        </tbody>
      }
    </table>
  </div>

  <JobDetailCard Job="ShownJob" HasResolved="shownJobId.HasValue" Key="shownJobId" />
</div>

@code
{
  private HubConnection connection = default!;
  private List<Job> jobs = [];
  private readonly HashSet<Guid> recentlyUpdated = [];
  private readonly HashSet<Guid> fadingJobIds = [];
  private Guid? shownJobId;
  private CancellationTokenSource? hoverCts;

  private Job? ShownJob => jobs.FirstOrDefault(j => j.Id == shownJobId);

  // 600ms dwell before committing to a row — a mouse just passing over
  // rows on its way somewhere else shouldn't repaint the detail panel.
  private void OnRowHoverStart(Guid jobId)
  {
    hoverCts?.Cancel();
    hoverCts = new CancellationTokenSource();
    var token = hoverCts.Token;

    _ = Task.Run(async () =>
    {
      await Task.Delay(600, token);
      if (token.IsCancellationRequested) return;

      await InvokeAsync(() =>
      {
        shownJobId = jobId;
        StateHasChanged();
      });
    });
  }

  // Only cancels a still-pending dwell — an already-resolved panel holds
  // its last value until a different row's hover resolves, so it stays
  // readable after the mouse moves away instead of vanishing.
  private void OnRowHoverEnd() => hoverCts?.Cancel();

  protected override async Task OnInitializedAsync()
  {
    var apiBaseAddress = config["ApiBaseAddress"]
      ?? throw new InvalidOperationException("ApiBaseAddress is not configured.");

    connection = new HubConnectionBuilder().WithUrl($"{apiBaseAddress}/hubs/jobs").Build();
    connection.On<Job>("JobUpdated", HandleJobUpdate);

    try
    {
      await connection.StartAsync();
    }
    catch { }

    await LoadJobs();
  }

  private async Task LoadJobs()
  {
    jobs = (await api.Get<Job>("/PrintJob")).Match(
      value => value.OrderByDescending(j => j.SubmittedAt).ToList(),
      error => []
    );
  }

  private string GetStatusClass(Job job) => job.Status switch
  {
    JobStatus.Failed => "sp-tag-failed",
    JobStatus.Processing => "sp-tag-processing",
    JobStatus.Queued => "sp-tag-queued",
    _ => "",
  };

  private void HandleJobUpdate(Job job)
  {
    InvokeAsync(async () =>
    {
      int idx = jobs.FindIndex(j => j.Id == job.Id);

      if (job.Status is JobStatus.Completed or JobStatus.Cancelled)
      {
        if (idx >= 0)
          await FadeAndRemoveJob(job.Id);

        return;
      }

      if (idx >= 0)
      {
        jobs[idx] = job;
      }
      else
      {
        int insertAt = jobs.FindIndex(j => j.SubmittedAt < job.SubmittedAt);
        jobs.Insert(insertAt < 0 ? jobs.Count : insertAt, job);
      }

      recentlyUpdated.Add(job.Id);
      _ = ClearRecentlyUpdated(job.Id);

      StateHasChanged();
    });
  }

  private async Task FadeAndRemoveJob(Guid jobId)
  {
    fadingJobIds.Add(jobId);
    StateHasChanged();
    await Task.Delay(500);
    jobs.RemoveAll(j => j.Id == jobId);
    fadingJobIds.Remove(jobId);

    // The row backing the shown detail panel is about to disappear.
    if (shownJobId == jobId)
      shownJobId = null;

    StateHasChanged();
  }

  private async Task CancelJob(Guid jobId) => await api.Delete($"/PrintJob/{jobId}");

  private async Task ClearRecentlyUpdated(Guid jobId)
  {
    await Task.Delay(1100);
    recentlyUpdated.Remove(jobId);
    await InvokeAsync(StateHasChanged);
  }

  public async ValueTask DisposeAsync()
  {
    hoverCts?.Cancel();
    await connection.DisposeAsync();
  }
}