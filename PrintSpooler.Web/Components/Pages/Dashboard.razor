@page "/dashboard"
@using ErrorOr
@using PrintSpooler.Core.Models
@using PrintSpooler.Core.Services
@using PrintSpooler.Web.Models;
@using PrintSpooler.Web.Services;
@implements IAsyncDisposable
@inject ConnectionManager hub
@inject PrinterApi printerApi
@inject JobApi jobApi

<PageTitle>Dashboard</PageTitle>

<div class="sp-printer-header">
  <div class="sp-section-title">Overview</div>
</div>

<div class="sp-stat-grid sp-stat-grid-5">
  <div class="sp-card">
    <p class="sp-stat-label">Printers Online</p>
    <p class="sp-stat-value">@(PrinterWebService.PrintersOnlineCount(printers))
      <span class="sp-stat-value-of">/@(printers.Count)</span>
    </p>
  </div>

  @foreach (var status in stats)
  {
    <div class="sp-card">
      <p class="sp-stat-label">@(status)</p>
      <p class="sp-stat-value">
        @(JobWebService.CountByStatus(status, cache))
      </p>
    </div>
  }
</div>

<div class="sp-section-title">Printers</div>
<div class="sp-printer-list">

  @foreach (var printer in printers)
  {
    <PrinterCard Key="printer.Id" Printer="printer" Rows="cache[printer.Id]" FadingRowIds="fadingRowIds"
                 CompletedRowIds="completedRowIds" OnFilesAdded="OnFilesAdded" OnRowAction="OnRowAction" />
  }

</div>

@code {
  private List<Printer> printers = [];
  private Dictionary<Guid, List<QueueRow>> cache = [];
  private readonly HashSet<Guid> fadingRowIds = [];
  private readonly HashSet<Guid> completedRowIds = [];
  private HashSet<JobStatus> stats = [JobStatus.Failed, JobStatus.Staged, JobStatus.Processing, JobStatus.Queued];

  protected override async Task OnInitializedAsync()
  {
    hub.JobUpdated += OnJobUpdated;
    hub.PrinterUpdated += OnPrinterUpdated;

    await hub.StartAsync()
          .ThenAsync(_ => LoadPrinters())
          .ThenAsync(_ => LoadJobs());
  }

  private async Task<ErrorOr<Success>> LoadPrinters()
  {
    var res = await printerApi.GetPrinters();

    if (res.IsError)
      return res.Errors;

    printers = res.Value;

    foreach (var printer in printers)
      cache.Add(printer.Id, new List<QueueRow>());

    return Result.Success;
  }

  private async Task<ErrorOr<Success>> LoadJobs()
  {

    var res = await jobApi.GetJobs();

    if (res.IsError)
      return res.Errors;

    List<Job> jobs = res.Value;

    foreach (var job in jobs)
      if (cache.TryGetValue(job.PrinterId, out var state))
        state.Add(QueueRow.FromJob(job));

    return Result.Success;
  }

  private void OnJobUpdated(Job job)
  {
    InvokeAsync(async () =>
    {
      var rows = cache[job.PrinterId];

      if (rows.FirstOrDefault(r => r.JobId == job.Id) is not { } row)
        return;

      row.ApplyJob(job);

      if (JobPolicies.IsTerminal(job.Status))
      {
        row.IsSending = false;
        completedRowIds.Add(row.Id);
        StateHasChanged();

        _ = FadeRowAfterDelay(job.PrinterId, row.Id);
        return;
      }

      StateHasChanged();
    });
  }

  private void OnPrinterUpdated(Printer update)
  {
    InvokeAsync(() =>
    {
      if (printers.FirstOrDefault(p => p.Id == update.Id) is not { } printer)
        return;

      printer.Status = update.Status;
      printer.LastHeartbeat = update.LastHeartbeat;
      StateHasChanged();
    });
  }

  private async Task SubmitEntry(QueueRow row)
  {
    if (row.PendingData is not { } pendingData)
      return;

    row.IsSending = true;
    await InvokeAsync(StateHasChanged);

    var res = await jobApi.SubmitJob(row);

    res.Switch(value =>
        {
          row.ApplyJob(value);
          pendingData = null;
        },
        errors =>
        {
          var error = errors[0];
          row.Status = JobStatus.Failed;

          row.ErrorText = error.Code == "refused"
            ? $"✗ {error.Description}"
            : $"✗ Error {error.Code}: {error.Description}";
        });

    row.IsSending = false;
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnFilesAdded(List<QueueRow> rows)
  {
    foreach (var group in rows.GroupBy(r => r.PrinterId))
      cache[group.Key].AddRange(group);

    await InvokeAsync(StateHasChanged);
  }

  private async Task FadeRowAfterDelay(Guid printerId, Guid rowId)
  {
    await Task.Delay(2000);

    try
    {
      var list = cache[printerId];

      if (list.FirstOrDefault(r => r.Id == rowId) is not { } row)
        return;

      fadingRowIds.Add(rowId);
      await InvokeAsync(StateHasChanged);
      await Task.Delay(500);

      list.Remove(row);
      fadingRowIds.Remove(rowId);
      await InvokeAsync(StateHasChanged);
    }
    finally
    {
      completedRowIds.Remove(rowId);
    }
  }

  private async Task DeleteAndFadeRow(QueueRow row)
  {
    if (row.JobId is { } jobId)
    {
      var res = await jobApi.DeleteJob(jobId);

      if (res.IsError)
        return;
    }

    fadingRowIds.Add(row.Id);
    await InvokeAsync(StateHasChanged);
    await Task.Delay(500);

    cache[row.PrinterId].Remove(row);
    fadingRowIds.Remove(row.Id);
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnRowAction(ActionArgs e)
  {
    List<QueueRow> rows = JobWebService.ToList(cache, e.Action, e.PrinterId, e.Ids);

    foreach (var r in rows)
    {
      switch (e.Action)
      {
        case RowActions.Delete:
          await DeleteAndFadeRow(r);
          break;
        case RowActions.Send:
          await SubmitEntry(r);
          break;
        case RowActions.Retry:
          // if the http request failed to submit job then jobId is null
          if (r.JobId is not { } jobId)
            await SubmitEntry(r);
          else
            await jobApi.RetryJob(jobId);
          break;
      }
    }
  }

  public async ValueTask DisposeAsync()
  {
    hub.JobUpdated -= OnJobUpdated;
    hub.PrinterUpdated -= OnPrinterUpdated;
  }
}
