@inherits LayoutComponentBase
@using PrintSpooler.Web.Services
@using ErrorOr
@implements IDisposable
@inject ApiClient api
@inject NavigationManager Nav

<div class="page">
  <div class="sidebar">
    <NavMenu />
  </div>

  <main>
    <div class="top-row">
      <h1 class="page-title"><span class="page-title-prompt">spooler:~$</span> @currentPageLabel</h1>
      <span class="system-status @(response ? "" : "system-status-offline")">
        SYSTEM
        @(response ? " ONLINE" : " OFFLINE")
      </span>
    </div>

    <article class="content">
      @Body
    </article>
  </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
  An unhandled error has occurred.
  <a href="." class="reload">Reload</a>
  <span class="dismiss">✕</span>
</div>


@code
{
  private bool response;
  private PeriodicTimer timer = default!;
  private string currentPageLabel = "dashboard";

  protected override async Task OnInitializedAsync()
  {
    UpdatePageLabel(Nav.Uri);
    Nav.LocationChanged += OnLocationChanged;

    timer = new PeriodicTimer(TimeSpan.FromSeconds(10));

    while (await timer.WaitForNextTickAsync())
    {
      response = await api.HealthCheck().Match(
        value => value.IsSuccessStatusCode,
        error => false
      );

      await InvokeAsync(StateHasChanged);
    }
  }

  private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
  {
    UpdatePageLabel(e.Location);
    InvokeAsync(StateHasChanged);
  }

  // Route path -> short prompt label. Falls back to the raw path segment
  // for anything not explicitly named here, instead of a generic default,
  // so a new page is still labeled with *something* meaningful.
  private void UpdatePageLabel(string uri)
  {
    var path = Nav.ToBaseRelativePath(uri).Trim('/');

    currentPageLabel = path switch
    {
      "" => "dashboard",
      _ => path,
    };
  }

  public void Dispose()
  {
    Nav.LocationChanged -= OnLocationChanged;
    timer.Dispose();
  }
}
