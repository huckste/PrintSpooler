@inherits LayoutComponentBase
@using PrintSpooler.Web.Models
@using PrintSpooler.Web.Services
@using ErrorOr
@implements IDisposable
@inject ApiClient api

<div class="app-shell">
  <header class="topbar">
    <div class="topbar-brand">
      <span class="topbar-brand-icon">⎙</span> Spooler
    </div>

    <NavMenu />

    <span class="system-status @health.CssClass()">
      SYSTEM
      @(health.Label())
    </span>
  </header>

  <main>
    <article class="content">
      @Body
    </article>
  </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
  An unhandled error has occurred.
  <a href="." class="reload">Reload</a>
  <span class="dismiss">✕</span>
</div>


@code
{
  private HealthState health = HealthState.Unknown;
  private readonly CancellationTokenSource cts = new();

  protected override async Task OnInitializedAsync()
  {
    await CheckHealth();

    _ = PollLoopAsync(cts.Token);
  }

  private async Task PollLoopAsync(CancellationToken ct)
  {
    // restarted (with a short backoff), not abandoned.
    while (!ct.IsCancellationRequested)
    {
      try
      {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        while (await timer.WaitForNextTickAsync(ct))
          await CheckHealth();
      }
      catch (OperationCanceledException)
      {
        break; // expected on Dispose — clean exit
      }
      catch
      {
        // unexpected throw from the loop machinery (timer/circuit state) —
        // back off and restart rather than leaving the indicator dead
        try
        {
          await Task.Delay(2000, ct);
        }
        catch
        {
          break;
        }
      }
    }
  }

  private async Task CheckHealth()
  {
    try
    {
      health = await api.HealthCheck().Match(
        value => value.IsSuccessStatusCode ? HealthState.Online : HealthState.Offline,
        error => HealthState.Offline
      );

      await InvokeAsync(StateHasChanged);
    }
    catch (OperationCanceledException)
    {
      // loop torn down mid-check (Dispose) — expected
    }
    catch
    {
      // any other failure — never let it drop the poll loop
    }
  }

  public void Dispose()
  {
    cts.Cancel();
    cts.Dispose();
  }
}
